# ═══════════════════════════════════════════════════════
# TaxiApp 3.0 — Konfigurimi
# Kopjo këtë file në .env dhe plotëso vlerat
# ═══════════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# JWT Secret (ndryshoje me string të gjatë random)
JWT_SECRET=ndryshoje-me-string-te-gjate-random-32-karaktere
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/taxiapp.db

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Email (për OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=taxiapp.ks@gmail.com
EMAIL_PASS=fjalekalimi-app-i-gmail
EMAIL_FROM=TaxiApp Kosova <taxiapp.ks@gmail.com>

# Multi-tenant
DEFAULT_TENANT=default
ALLOW_REGISTRATION=false

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Admin i parë (krijohet në nisje)
FIRST_ADMIN_USERNAME=G
FIRST_ADMIN_PASSWORD=1
FIRST_ADMIN_NAME=Granit Gashi
