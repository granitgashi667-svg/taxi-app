rules_version = '2';

// ═══════════════════════════════════════════════════════
// TaxiApp 3.0 — Firestore Security Rules
// Roli lexohet nga Custom Claims (token), jo nga dokumenti
// ═══════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ FUNKSIONET NDIHMËSE ═══
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function hasRole(roles) {
      return isAuthenticated() && getRole() in roles;
    }

    function isDriver() {
      return hasRole(['driver']);
    }

    function isClient() {
      return hasRole(['client']);
    }

    function isOperator() {
      return hasRole(['operator', 'dispatcher']);
    }

    function isDispatcher() {
      return hasRole(['operator', 'dispatcher', 'supervisor', 'manager', 'director', 'admin']);
    }

    function isSupervisor() {
      return hasRole(['supervisor', 'manager', 'director', 'admin']);
    }

    function isManager() {
      return hasRole(['manager', 'director', 'admin']);
    }

    function isDirector() {
      return hasRole(['director', 'admin']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ═══ OPERATORS ═══
    // Vetëm Cloud Function (Admin SDK) mund të shkruajë
    match /operators/{operatorId} {
      allow read: if isOwner(operatorId) || isDispatcher();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ═══ DRIVERS ═══
    // Vetëm Cloud Function krijon. Shofer vetëm vetveten.
    match /drivers/{driverId} {
      allow read: if isDispatcher() || isOwner(driverId);
      allow create, delete: if false;
      allow update: if isDispatcher() ||
                       (isOwner(driverId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['mode', 'lat', 'lng', 'lastSeen', 'online', 'status']));
    }

    // Koleksion publik për klientin (pa telefon/GPS)
    match /drivers_public/{driverId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ═══ VEHICLES ═══
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // ═══ CLIENTS ═══
    match /clients/{clientId} {
      allow read: if isOwner(clientId) || isDispatcher();
      allow create: if isOwner(clientId);
      allow update: if isOwner(clientId) ||
                       (isDispatcher() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['blocked', 'notes', 'tags']));
      allow delete: if isDirector();
    }

    // ═══ ORDERS ═══
    match /orders/{orderId} {
      allow read: if isDispatcher() ||
                     (isDriver() && resource.data.driverId == request.auth.uid) ||
                     (isClient() && resource.data.clientId == request.auth.uid);

      // Klient krijon vetëm për vete
      allow create: if (isDispatcher()) ||
                       (isClient() &&
                        request.resource.data.clientId == request.auth.uid &&
                        request.resource.data.status == 'waiting');

      // Update me kufizime fushash
      allow update: if isDispatcher() ||
                       (isDriver() &&
                        resource.data.driverId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt', 'lat', 'lng'])) ||
                       (isClient() &&
                        resource.data.clientId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'cancelledReason', 'cancelledAt']) &&
                        request.resource.data.status in ['cancelled']);

      allow delete: if isManager();
    }

    // ═══ MESSAGES (operator↔driver) ═══
    match /messages/{messageId} {
      allow read: if isDispatcher() ||
                     (isDriver() && resource.data.to == request.auth.uid) ||
                     (isDriver() && resource.data.from == request.auth.uid);
      allow create: if isDispatcher() ||
                       (isDriver() && request.resource.data.from == request.auth.uid);
      allow update: if false;
      allow delete: if isDirector();
    }

    // ═══ DRIVER_MESSAGES (chat i ri) ═══
    match /driver_messages/{threadId} {
      allow read: if isDispatcher() ||
                     (resource.data.driverId == request.auth.uid);
      allow create: if isAuthenticated() &&
                       request.resource.data.driverId == request.auth.uid;
      allow update: if isDispatcher() ||
                       (resource.data.driverId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['unreadByDriver', 'unreadByOperator', 'lastMessage', 'lastMessageAt']));

      match /messages/{messageId} {
        allow read: if isDispatcher() ||
                       (get(/databases/$(database)/documents/driver_messages/$(threadId)).data.driverId == request.auth.uid);
        allow create: if isDispatcher() ||
                         (get(/databases/$(database)/documents/driver_messages/$(threadId)).data.driverId == request.auth.uid &&
                          request.resource.data.senderId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ═══ CHATS — vetëm pjesëmarrës ═══
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() &&
                            request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ═══ CALLS ═══
    match /calls/{callId} {
      allow read, create: if isDispatcher();
      allow update: if isDispatcher();
      allow delete: if isDirector();
    }

    match /call_log/{logId} {
      allow read: if isDispatcher();
      allow create: if isDispatcher();
      allow update, delete: if false;
    }

    // ═══ TRANSFERS ═══
    match /transfers/{transferId} {
      allow read, create: if isDispatcher();
      allow update: if isDispatcher();
      allow delete: if false;
    }

    // ═══ SMS_QUEUE — vetëm Cloud Function shkruan ═══
    match /sms_queue/{queueId} {
      allow read: if isDispatcher();
      allow create, update, delete: if false;
    }

    match /sms_templates/{templateId} {
      allow read: if isDispatcher();
      allow write: if isManager();
    }

    match /sms_log/{logId} {
      allow read: if isDispatcher();
      allow create, update, delete: if false;
    }

    // ═══ EMAIL_QUEUE — vetëm Cloud Function ═══
    match /email_queue/{emailId} {
      allow read: if isManager();
      allow create, update, delete: if false;
    }

    // ═══ PUSH_QUEUE — vetëm Cloud Function ═══
    match /push_queue/{pushId} {
      allow read: if isDispatcher();
      allow create, update, delete: if false;
    }

    // ═══ LOCATIONS ═══
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update: if isDispatcher();
      allow delete: if isManager();
    }

    // ═══ ZONES ═══
    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // ═══ RELEASES ═══
    match /releases/{releaseId} {
      allow read: if isAuthenticated();
      allow create: if isDispatcher() || isDriver();
      allow update, delete: if false;
    }

    // ═══ POSITIONS_HISTORY — TTL 90 ditë ═══
    match /positions_history/{positionId} {
      allow read: if isSupervisor();
      allow create: if isDriver() || isDispatcher();
      allow update, delete: if false;
    }

    // ═══ SHIFTS ═══
    match /shifts/{shiftId} {
      allow read: if isDispatcher();
      allow write: if isDispatcher();
    }

    // ═══ VACATIONS ═══
    match /vacations/{vacationId} {
      allow read: if isDispatcher();
      allow create: if isAuthenticated();
      allow update: if isDispatcher();
      allow delete: if isDirector();
    }

    // ═══ BLACKLIST ═══
    match /blacklist/{entryId} {
      allow read: if isDispatcher();
      allow create: if isDispatcher();
      allow update: if isManager();
      allow delete: if isDirector();
    }

    // ═══ EMERGENCIES (SOS) ═══
    match /emergencies/{emergencyId} {
      allow read: if isDispatcher();
      allow create: if isAuthenticated();
      allow update: if isDispatcher();
      allow delete: if isDirector();
    }

    // ═══ RATINGS ═══
    match /ratings/{ratingId} {
      allow read: if isDispatcher() ||
                     (isDriver() && resource.data.driverId == request.auth.uid) ||
                     (isClient() && resource.data.clientId == request.auth.uid);
      allow create: if isClient() &&
                       request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isDirector();
    }

    // ═══ AUDIT_LOG — vetëm Cloud Function shkruan ═══
    match /audit_log/{logId} {
      allow read: if isDirector();
      allow create, update, delete: if false;
    }

    // ═══ SETTINGS ═══
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isDirector();
    }

    // ═══ WHITELIST ═══
    match /whitelist/{whitelistId} {
      allow read: if isManager();
      allow write: if isDirector();
    }

    // ═══ BACKUPS — vetëm Cloud Function ═══
    match /backups/{backupId} {
      allow read: if isDirector();
      allow create, update, delete: if false;
    }

    // ═══ DISPLAY_SETTINGS ═══
    match /display_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isDispatcher();
    }

    // ═══ TARGETS ═══
    match /targets/{targetId} {
      allow read: if isDispatcher();
      allow create, update: if isManager();
      allow delete: if isDirector();
    }

    // ═══ LOYALTY ═══
    match /loyalty_cards/{cardId} {
      allow read: if isDispatcher() ||
                     (isClient() && resource.data.clientId == request.auth.uid) ||
                     (isClient() && resource.data.phone == request.auth.token.phone_number);
      allow create, update: if isDispatcher();
      allow delete: if isManager();
    }

    match /loyalty_transactions/{txId} {
      allow read: if isDispatcher() ||
                     (isClient() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ═══ FUEL ═══
    match /fuel_prices/{priceId} {
      allow read: if isAuthenticated();
      allow create, update: if isManager();
      allow delete: if isDirector();
    }

    match /fuel_refills/{refillId} {
      allow read: if isDispatcher() || isDriver();
      allow create: if isDispatcher() || isDriver();
      allow update, delete: if isManager();
    }

    // ═══ SALARIES ═══
    match /salaries/{salaryId} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if isDirector();
    }

    match /salary_adjustments/{adjId} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if isDirector();
    }

    // ═══ FIXED ROUTES ═══
    match /fixed_price_routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // ═══ IMPORT LOGS ═══
    match /import_logs/{logId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update, delete: if false;
    }

    // ═══ INTEGRATION LOGS ═══
    match /integration_logs/{logId} {
      allow read: if isManager();
      allow create: if isDispatcher();
      allow update, delete: if false;
    }

    // ═══ TRACKERS ═══
    match /trackers/{trackerId} {
      allow read: if isDispatcher();
      allow write: if isManager();
    }

    match /tracker_positions/{posId} {
      allow read: if isDispatcher();
      allow create: if isDispatcher() || isDriver();
      allow update, delete: if isManager();
    }

    // ═══ STREETS & STANDS ═══
    match /streets/{streetId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /stands/{standId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // ═══ MOBILE USERS ═══
    match /mobile_users/{userId} {
      allow read: if isOwner(userId) || isDispatcher();
      allow create: if isOwner(userId) || isDispatcher();
      allow update: if isOwner(userId) ||
                       (isDispatcher() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['blocked', 'tags', 'notes']));
      allow delete: if isManager();
    }

    // ═══ WALLETS ═══
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow create: if isOwner(userId);
      allow update: if false; // vetëm Cloud Function

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isManager();
        allow create, update, delete: if false;
      }
    }

    // ═══ TË TJERA — DENY ALL ═══
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
